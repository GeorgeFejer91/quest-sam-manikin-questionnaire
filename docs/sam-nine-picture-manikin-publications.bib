  status = {confirmed-nine-visible},
  evidence = {Methods and Fig. 1 show 9-point valence and arousal SAM rows; participants clicked one of nine images in the scale.},
  sam_source_citation = {The SAM use paragraph cites Di Crosta et al. 2020, and the reference list also includes Bradley and Lang 1994 for the original SAM instrument. No Roeggla, CWI, GitHub, or SVG asset credit was found in the article XML.},
  stimulus_source = {The 200 natural-hazard photographs were downloaded from Flickr under CC0, CC BY 4.0, or CC BY-SA 4.0-compatible terms; Figshare Table 2 in Prete, Laeng, and Tommasi 2021 gives individual Flickr links, photographer names, sizes, and licenses.},
  artwork_note = {Visual comparison of the paper's Figure 1 with the local Roeggla/CWI SVG grids shows the same underlying 9-valence and 9-arousal manikin drawings, though the publication figure is a low-resolution raster with separate gray boxes.}
}

