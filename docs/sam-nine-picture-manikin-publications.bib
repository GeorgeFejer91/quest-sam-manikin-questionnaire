% Running bibliography for publications that mention using a nine-picture /
% nine-manikin Self-Assessment Manikin (SAM) implementation.
%
% Inclusion status:
% - confirmed-nine-visible: source text or figure explicitly says participants
%   selected among nine images/manikins/symbols, or that images corresponded to
%   nine response options.
% - candidate-needs-visual-verification: source likely used a nine-picture SAM,
%   but currently verified only from snippets or wording weaker than "nine
%   images/manikins".
% - contrast-original-five-plus-gaps: useful baseline showing the original
%   paper-and-pencil SAM has five figures plus four between-figure positions,
%   yielding a 9-point rating without nine visible manikin drawings.

@article{bradley1994measuringEmotionSamSemanticDifferential,
  author = {Bradley, Margaret M. and Lang, Peter J.},
  title = {Measuring emotion: The Self-Assessment Manikin and the Semantic Differential},
  journal = {Journal of Behavior Therapy and Experimental Psychiatry},
  year = {1994},
  volume = {25},
  number = {1},
  pages = {49--59},
  doi = {10.1016/0005-7916(94)90063-9},
  pmid = {7962581},
  status = {contrast-original-five-plus-gaps},
  evidence = {The paper-and-pencil version lets subjects mark one of five figures or a position between figures, producing a 9-point scale without nine visible manikin drawings.}
}

